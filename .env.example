# Variables que lee docker-compose.yml (este archivo va en la RAÍZ del repo, no en backend/).
# Copiar a .env y completar. En desarrollo se puede omitir: el compose usa cova/cova/siniestros y los puertos 8080/8443.
#
# IMPORTANTE: Postgres usa estos valores SOLO la primera vez, cuando el volumen está vacío y crea la base.
# Cambiarlos después no cambia la contraseña de una base existente.
# En producción: definir una contraseña larga y aleatoria ANTES del primer "docker compose up".
# Usar solo letras y números (va dentro de DATABASE_URL; @ : / # la romperían). Para generarla: openssl rand -hex 32

POSTGRES_USER=cova
POSTGRES_PASSWORD=cambiar-por-una-contrasena-larga-y-aleatoria
POSTGRES_DB=siniestros

# --- Solo en el VPS -----------------------------------------------------------------------------------------
# Dominio del sitio para el certificado SSL. Sin dominio propio, usar sslip.io con la IP del VPS
# separada por guiones: la IP 203.0.113.10 → 203-0-113-10.sslip.io (apunta sola a esa IP).
# Vacío = Nginx sirve solo HTTP.
DOMAIN=

# Puertos públicos de Nginx. En el VPS: 80 y 443 (estándar, los necesita Let's Encrypt). Vacíos = 8080 y 8443.
HTTP_PORT=
HTTPS_PORT=

# "ssl" activa el servicio que renueva el certificado automáticamente. En desarrollo, dejar vacío.
COMPOSE_PROFILES=
