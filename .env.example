# Variables que lee docker-compose.yml (este archivo va en la RAÍZ del repo, no en backend/).
# Copiar a .env y completar. En desarrollo se puede omitir: el compose usa cova/cova/siniestros y los puertos 8080/8443.
#
# IMPORTANTE: Postgres usa estos valores SOLO la primera vez, cuando el volumen está vacío y crea la base.
# Cambiarlos después no cambia la contraseña de una base existente.
# En producción: definir una contraseña larga y aleatoria ANTES del primer "docker compose up".
# Usar solo letras y números (va dentro de DATABASE_URL; @ : / # la romperían). Para generarla: openssl rand -hex 32

POSTGRES_USER=cova
POSTGRES_PASSWORD=cambiar-por-una-contrasena-larga-y-aleatoria
POSTGRES_DB=siniestros

# --- Solo en el VPS -----------------------------------------------------------------------------------------
# Dominio del sitio para el certificado SSL. Sin dominio propio, usar sslip.io con la IP del VPS
# separada por guiones: la IP 203.0.113.10 → 203-0-113-10.sslip.io (apunta sola a esa IP).
# Vacío = Nginx sirve solo HTTP.
DOMAIN=

# Puertos públicos de Nginx. En el VPS: 80 y 443 (estándar, los necesita Let's Encrypt). Vacíos = 8080 y 8443.
HTTP_PORT=
HTTPS_PORT=

# Servicios que solo corren en el VPS: "ssl" renueva el certificado automáticamente y "backup" hace los backups
# diarios a Cloudflare R2. En el VPS: COMPOSE_PROFILES=ssl,backup. En desarrollo, dejar vacío.
COMPOSE_PROFILES=

# --- Backups a Cloudflare R2 (solo en el VPS, perfil "backup") ----------------------------------------------
# Usan las credenciales R2_* de backend/.env. Las BACKUP_* pueden ir acá o en backend/.env.
# Detalle en backup/backup.sh.
#
# OBLIGATORIA. Contraseña con la que se cifran los dumps de la base antes de subirlos. Generarla con
# openssl rand -hex 32 y guardarla TAMBIÉN fuera del VPS (gestor de contraseñas): sin ella los backups no se pueden
# restaurar. Si se cambia, los backups anteriores siguen necesitando la contraseña con la que se hicieron.
BACKUP_CLAVE=
# Bucket de destino. Vacío = el mismo de los documentos (R2_BUCKET), dentro de la carpeta BACKUP_PREFIX.
BACKUP_BUCKET=
# Token de R2 solo para backups (Object Read & Write, únicamente sobre el bucket de backups). Los documentos se leen
# con el token del backend, así el de la app no puede borrar backups. Vacío = el del backend para todo.
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
# Opcionales. Vacíos = estos valores: carpeta dentro del bucket (backups), hora del backup diario en hora de
# Argentina (3), días que se guardan en R2 (30, RNF-04) y días que se guardan también en el VPS (7).
BACKUP_PREFIX=
BACKUP_HORA=
BACKUP_RETENCION_DIAS=
BACKUP_LOCAL_DIAS=
