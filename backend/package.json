{
  "name": "siniestros-cova-backend",
  "private": true,
  "version": "0.0.0",
  "description": "API del sistema de gestión de siniestros — Estudio Cova",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "prebuild": "npm run prisma:generate",
    "build": "tsc && tsdown",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "pretypecheck": "npm run prisma:generate",
    "typecheck": "tsc",
    "lint": "oxlint",
    "test:r2": "node --experimental-strip-types --test tests/r2.test.mjs",
    "r2:smoke": "tsx --env-file=.env src/scripts/probar-r2.ts",
    "r2:demo": "tsx --env-file=.env src/dev/r2-demo/server.ts",
    "test:r2-demo": "node --experimental-strip-types --test tests/r2-demo.test.mjs",
    "prisma:format": "prisma format --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "prisma:migrate:deploy": "prisma migrate deploy --config prisma.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@cova/shared": "*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "oxlint": "^1.87.0",
    "prisma": "7.10.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
