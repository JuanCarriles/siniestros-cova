{
  "name": "siniestros-cova-backend",
  "private": true,
  "version": "0.0.0",
  "description": "API del sistema de gestión de siniestros — Estudio Cova",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc && tsdown",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc",
    "lint": "oxlint"
  },
  "dependencies": {
    "@cova/shared": "*",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "oxlint": "^1.87.0",
    "tsdown": "^0.21.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
