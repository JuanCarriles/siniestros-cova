{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    /* tsc solo chequea tipos; el build lo hace tsdown (ver tsdown.config.ts) */
    "noEmit": true,
    "allowImportingTsExtensions": true,

    /* Chequeos */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "prisma/seeds", "tsdown.config.ts", "prisma.config.ts"]
}
