# Servidor
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://cova:cova@localhost:5432/siniestros?schema=public

# Sesión (cookie httpOnly) — RNF-08: 7 horas
SESSION_SECRET=cambiar-por-un-valor-largo-y-aleatorio
SESSION_TTL_HOURS=7

# Recuperación de contraseña — RF-05: 5 minutos
RESET_TOKEN_TTL_MINUTES=5

# Cloudflare R2 (compatible S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=siniestros-cova

# Documentos — RNF-11
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_EXT=pdf,jpg,jpeg,png,docx,xlsx

# Mail (Resend)
RESEND_API_KEY=
MAIL_FROM="Estudio Cova <no-reply@example.com>"

# Jobs
SINIESTRO_DEMORADO_HORAS=72
INFORME_MENSUAL_CRON="0 8 1 * *"
