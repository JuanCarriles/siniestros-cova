# Servidor
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://cova:cova@localhost:5432/siniestros?schema=public

# Sesión (cookie httpOnly, guardada en la tabla Sesion) — RNF-08: vence tras 7 horas sin actividad
SESSION_TTL_HOURS=7
# Cookie de sesión solo por HTTPS. Vacío = true en producción, false en desarrollo.
# En el VPS sin dominio ni HTTPS (http://IP:8080) poner false, o el login no va a funcionar.
COOKIE_SECURE=

# Recuperación de contraseña — RF-05: 5 minutos
RESET_TOKEN_TTL_MINUTES=5

# Cloudflare R2 (compatible S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=siniestro-cova-dev
# Opcional: se deriva de R2_ACCOUNT_ID. Copiar el endpoint S3 si se usa una jurisdicción.
R2_ENDPOINT=
# Entre 1 y 300 segundos; nunca guardar esta URL temporal en la base.
R2_SIGNED_URL_TTL_SECONDS=60

# Documentos — RNF-11
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_EXT=pdf,jpg,jpeg,png,docx,xlsx

# Mail (Resend)
RESEND_API_KEY=
MAIL_FROM="Estudio Cova <no-reply@example.com>"

# Jobs
SINIESTRO_DEMORADO_HORAS=72
INFORME_MENSUAL_CRON="0 8 1 * *"
