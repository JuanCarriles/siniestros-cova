# Servidor
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:5173

# Base de datos (PostgreSQL)
DATABASE_URL=postgresql://cova:cova@localhost:5432/siniestros?schema=public

# Sesión (cookie httpOnly, guardada en la tabla Sesion) — RNF-08: vence tras 7 horas sin actividad
SESSION_TTL_HOURS=7
# Cookie de sesión solo por HTTPS. Vacío = true en producción, false en desarrollo.
# En el VPS sin dominio ni HTTPS (http://IP:8080) poner false, o el login no va a funcionar.
COOKIE_SECURE=

# Casos demorados (E5-10): cada cuántos minutos se revisan para avisar a las 72 horas y a los 7 días sin
# movimiento. 0 apaga la tarea (por ejemplo, si corre una segunda instancia del backend).
DEMORAS_CADA_MINUTOS=60

# Recuperación de contraseña — RF-05: 5 minutos
RESET_TOKEN_TTL_MINUTES=5

# Cloudflare R2 (compatible S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=siniestro-cova-dev
# Separación de objetos: dev en tu PC (también con Docker); produccion en el VPS.
# Obligatorio con NODE_ENV=production (también Docker local): sin él la API no arranca.
# Con tsx en development/test, si falta se usa dev.
R2_ENTORNO=dev
# Opcional: se deriva de R2_ACCOUNT_ID. Copiar el endpoint S3 si se usa una jurisdicción.
R2_ENDPOINT=
# Entre 1 y 300 segundos; nunca guardar esta URL temporal en la base.
R2_SIGNED_URL_TTL_SECONDS=60

# Documentos — RNF-11
# Plantillas mantiene un máximo fijo de 10 MiB en shared (PLANTILLA_MAX_BYTES).
# Mantener UPLOAD_MAX_MB=10 para admitir ese máximo; un valor menor también limita R2.
# Si cambia el máximo de la historia, revisar shared y el límite multipart de Nginx.
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_EXT=pdf,jpg,jpeg,png,docx,xlsx

# Mail (Resend)
RESEND_API_KEY=
# Sin dominio verificado: sólo permite enviar al correo vinculado a tu cuenta de Resend.
# Al verificar el dominio, reemplazar por una dirección del dominio propio.
RESEND_FROM="Estudio Cova <onboarding@resend.dev>"

# Jobs
SINIESTRO_DEMORADO_HORAS=72
INFORME_MENSUAL_CRON="0 8 1 * *"

# Informe mensual: día 1, 07:00 Argentina; recupera pendientes al iniciar.
INFORMES_AUTOMATICOS=true
# Panel temporal de prueba (solo superadministrador). Habilitar también al usar Docker.
INFORMES_PRUEBA_HABILITADOS=false
